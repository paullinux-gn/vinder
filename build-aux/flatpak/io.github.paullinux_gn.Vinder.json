{
  "app-id": "io.github.paullinux_gn.Vinder",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "nautilus",
  "finish-args": [
    "--device=dri",
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--talk-name=org.gnome.OnlineAccounts",
    "--filesystem=host",
    "--filesystem=/tmp",
    "--talk-name=org.gtk.vfs.*",
    "--talk-name=org.gtk.MountOperationHandler",
    "--filesystem=xdg-run/gvfsd",
    "--filesystem=xdg-run/dconf",
    "--talk-name=ca.desrt.dconf",
    "--talk-name=org.gnome.NautilusPreviewer",
    "--talk-name=org.gnome.NautilusPreviewer.Devel",
    "--talk-name=org.gnome.DiskUtility",
    "--talk-name=org.gnome.Settings",
    "--talk-name=org.gnome.Console",
    "--talk-name=org.freedesktop.Flatpak",
    "--talk-name=org.gnome.Mutter.ServiceChannel",
    "--add-policy=LocalSearch3.dbus:org.freedesktop.Tracker3.Miner.Files=tracker:Audio",
    "--add-policy=LocalSearch3.dbus:org.freedesktop.Tracker3.Miner.Files=tracker:Documents",
    "--add-policy=LocalSearch3.dbus:org.freedesktop.Tracker3.Miner.Files=tracker:FileSystem",
    "--add-policy=LocalSearch3.dbus:org.freedesktop.Tracker3.Miner.Files=tracker:Pictures",
    "--add-policy=LocalSearch3.dbus:org.freedesktop.Tracker3.Miner.Files=tracker:Music",
    "--add-policy=LocalSearch3.dbus:org.freedesktop.Tracker3.Miner.Files=tracker:Video"
  ],
  "modules": [
    {
      "name": "inih",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Ddefault_library=shared",
        "-Ddistro_install=true",
        "-Dwith_INIReader=true",
        "-Dtests=false"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/benhoyt/inih/archive/refs/tags/r62.tar.gz",
          "sha256": "9c15fa751bb8093d042dae1b9f125eb45198c32c6704cd5481ccde460d4f8151"
        }
      ]
    },
    {
      "name": "exiv2",
      "config-opts": [
        "-DCMAKE_INSTALL_PREFIX=/app",
        "-DCMAKE_INSTALL_LIBDIR=/app/lib"
      ],
      "buildsystem": "cmake-ninja",
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/Exiv2/exiv2.git",
          "branch": "0.28.x"
        }
      ]
    },
    {
      "name": "gexiv2",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "--libdir=lib",
        "-Dintrospection=false",
        "-Dvapi=false",
        "-Dtools=false",
        "-Dpython3=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/gexiv2.git",
          "tag": "0.16.0"
        }
      ]
    },
    {
      "name": "gnome-desktop",
      "buildsystem": "meson",
      "config-opts": [
        "--libdir=lib",
        "-Ddebug_tools=false",
        "-Ddesktop_docs=false",
        "-Dlegacy_library=false",
        "-Dsystemd=disabled",
        "-Dudev=disabled",
        "-Dqr=disabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/gnome-desktop.git",
          "tag": "51.0"
        },
        {
          "type": "patch",
          "path": "gnome-desktop-host-root-thumbnails.patch"
        }
      ]
    },
    {
      "name": "gnome-autoar",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "--libdir=lib",
        "-Dintrospection=disabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/gnome-autoar.git",
          "commit": "ed5ac29babba0dec00d9de3e826bb48706bcbd76"
        }
      ]
    },
    {
      "name": "libcloudproviders",
      "buildsystem": "meson",
      "builddir": true,
      "config-opts": [
        "--libdir=lib",
        "-Dintrospection=false",
        "-Dvapigen=false"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/libcloudproviders.git",
          "commit": "f00b94b1cc0739fa1c9d6085e94bc3d0c6590344"
        }
      ]
    },
    {
      "name": "localsearch",
      "buildsystem": "meson",
      "cleanup": [
        "/bin",
        "/etc"
      ],
      "config-opts": [
        "--libdir=lib",
        "-Dfunctional_tests=false",
        "-Dsandbox_tests=false",
        "-Ddomain_prefix=io.github.paullinux_gn.Vinder",
        "-Dextract=true",
        "-Dlandlock=disabled",
        "-Dman=false",
        "-Dminer_fs=true",
        "-Dminer_fs_cache_location=$XDG_CACHE_HOME/nautilus/miner/files",
        "-Dsystemd_user_services=false",
        "-Dwriteback=false",
        "-Dbattery_detection=none"
      ],
      "post-install": [
        "echo 'Removing quotations from DBus service files'",
        "ls -alh /app/share/dbus-1/services/org.*",
        "sed -i 's/\"//g' /app/share/dbus-1/services/org.*"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/localsearch.git",
          "commit": "0198ee0cc430184db07a63061818d7493db12caa"
        }
      ]
    },
    {
      "buildsystem": "meson",
      "builddir": true,
      "name": "nautilus",
      "config-opts": [
        "--libdir=lib",
        "-Dprofile=Vinder",
        "-Dtests=none",
        "-Dselinux=disabled"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../..",
          "skip": [
            ".git",
            "subprojects/libgxdp",
            "vinder-icon.png",
            "vinder-icon-mica.png",
            "vinder-icon-ocean.png",
            "vinder-icon-orchid.png",
            "vinder-icon-sunset.png"
          ]
        },
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/libgxdp.git",
          "commit": "528966b82cfb8c276319aa1436d424b949a274e0",
          "dest": "subprojects/libgxdp"
        },
        {
          "type": "patch",
          "path": "libgxdp-use-portal-settings-in-flatpak.patch"
        }
      ]
    }
  ],
  "branch": "stable"
}
